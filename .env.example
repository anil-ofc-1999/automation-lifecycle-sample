# Copy this file to .env and adjust for your machine.
# Never commit .env — it is git-ignored.

NODE_ENV=development
PORT=3000

# Local PostgreSQL 16 (see README "Database setup"). Placeholder password — use your own.
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/appointments

# Test-only password given to every seeded account (npm run db:seed). Not a real password.
SEED_PASSWORD=Password123

# Secret used to sign login tokens (JWT). Must be at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=1h
# Login attempts allowed per IP per minute (NFR-3)
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Database connections per API instance (default 20). Keep below your database limit.
DB_POOL_MAX=20

# All API requests allowed per IP per minute (default 300, D-34)
API_RATE_LIMIT_PER_MINUTE=300

# Registrations allowed per IP per minute (default 10)
REGISTER_RATE_LIMIT_PER_MINUTE=10

# Proxies in front of the API: 0 locally, 1 on Render (real client IP for rate limits)
TRUST_PROXY_HOPS=0

# The web app's address, used in "forgot password" email links (D-37)
APP_URL=http://localhost:4200
# How long a "forgot password" link works, in minutes (default 30)
PASSWORD_RESET_MINUTES=30

# Appointment emails (FR-7): memory (tests) | log (default: logged, not sent) | smtp
MAIL_MODE=log
MAIL_FROM=Doctor Appointments <no-reply@example.com>
# Only for MAIL_MODE=smtp, e.g. smtps://user:password@smtp.example.com:465 (keep it out of git)
# SMTP_URL=
