# Copy this file to .env and adjust for your machine.
# Never commit .env — it is git-ignored.

NODE_ENV=development
PORT=3000

# Local PostgreSQL 16 (see README "Database setup"). Placeholder password — use your own.
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/appointments

# Test-only password given to every seeded account (npm run db:seed). Not a real password.
SEED_PASSWORD=Password123
